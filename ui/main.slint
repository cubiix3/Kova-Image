import { Palette, ScrollView } from "std-widgets.slint";
import { Theme, Interaction } from "theme.slint";
import { Tool, Rule, Divider, Group, ToggleRow } from "controls.slint";
import { Track } from "track.slint";
import { Icons } from "icons.slint";

export struct InfoField { label: string, value: string }

export component ViewerWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "Kova Image";
    icon: @image-url("../assets/kova.svg");
    preferred-width: 1080px; preferred-height: 740px; min-width: 640px; min-height: 420px;
    no-frame: true;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    in property <image> picture;
    in property <bool> has-image: false;
    in property <bool> loading: false;
    in property <bool> is-video;
    in property <float> video-progress;
    in property <string> time-label: "0:00 / 0:00";
    in property <float> volume: 0.7;
    in property <bool> muted;
    in-out property <bool> video-autoplay: true;
    in-out property <bool> video-loop: false;
    out property <bool> slider-focused: Interaction.slider-focused;
    callback seek(float);
    callback volume-change(float);
    in property <string> filename: "Kova Image";
    in property <string> status;
    in property <string> feedback;
    in property <[InfoField]> info-fields;
    in property <string> zoom-label: "Fit";
    in property <float> display-width;
    in property <float> display-height;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <int> rotation;
    in property <bool> flip-h;
    in property <bool> flip-v;
    in property <bool> fullscreen;
    in property <bool> chrome: true;
    in property <bool> animated;
    in property <bool> paused;
    in property <bool> light-background;
    in-out property <bool> pixelated;
    in-out property <bool> show-more;
    in-out property <bool> show-info;
    in-out property <bool> show-settings;
    in-out property <bool> autoplay: true;
    in-out property <bool> looping: true;
    in-out property <bool> natural-sort: true;
    in-out property <bool> auto-hide: true;
    in-out property <bool> wheel-zoom: true;
    out property <float> viewport-width: canvas.width / 1px;
    out property <float> viewport-height: canvas.height / 1px;
    out property <float> viewport-top: canvas.y / 1px;
    out property <float> viewport-left: canvas.x / 1px;
    callback command(string);
    callback setting(string,bool);
    callback drag-window;
    callback activity;

    in property <string> image-detail;
    in property <string> error-title;
    in property <string> error-detail;
    in property <string> position-label;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <bool> fit-active: true;
    in property <bool> actual-active;
    in property <string> default-fit: "window";
    in-out property <bool> keyboard-mode <=> Interaction.keyboard;
    out property <bool> control-focused: Interaction.focused-control != 0 && Interaction.keyboard;
    public function focus-viewer() {
        canvas-focus.focus();
        Interaction.focused-control = 0;
        Interaction.slider-focused = false;
        Interaction.hint = "";
    }
    out property <bool> chrome-hovered: header-touch.has-hover || bar-touch.has-hover;
    changed chrome-hovered => { root.activity(); }
    changed control-focused => { root.activity(); }
    out property <float> chrome-top: Theme.header-height / 1px;
    out property <float> controls-left: bar.x / 1px;
    out property <float> controls-top: bar.y / 1px;
    out property <float> controls-width: bar.width / 1px;
    out property <float> controls-height: bar.height / 1px;
    property <length> bar-height: Theme.bar-height;
    property <bool> modal: root.show-info || root.show-settings;
    changed modal => { if !root.modal { root.focus-viewer(); } root.activity(); }
    changed show-more => { if !root.show-more && !root.modal { root.focus-viewer(); } root.activity(); }
    property <bool> tools-enabled: root.chrome && !root.modal && !root.show-more;
    property <bool> header-enabled: (!root.fullscreen || root.chrome) && !root.modal && !root.show-more;
    property <bool> image-tools: root.tools-enabled && root.has-image && !root.loading && !root.is-video;
    property <bool> compact: root.width < 820px;

    canvas := Rectangle {
        x: 0px;
        y: root.fullscreen ? 0px : Theme.header-height;
        height: root.height - self.y;
        width: root.width;
        background: root.light-background && root.has-image ? #cfd3d8 : Theme.canvas;
        clip: true;
        canvas-focus := FocusScope {
            enabled: !root.modal && !root.show-more;
            focus-on-tab-navigation: false;
            focus-gained(reason) => { Interaction.focused-control = 0; Interaction.hint = ""; }
        }
        if root.has-image: Image {
            source: root.picture;
            x: (parent.width - self.width)/2 + root.pan-x * 1px;
            y: (parent.height - self.height)/2 + root.pan-y * 1px;
            width: root.display-width * 1px;
            height: root.display-height * 1px;
            image-fit: fill;
            transform-rotation: root.rotation * 1deg;
            transform-scale-x: root.flip-h ? -100% : 100%;
            transform-scale-y: root.flip-v ? -100% : 100%;
            image-rendering: root.pixelated && !root.is-video ? ImageRendering.pixelated : ImageRendering.smooth;
            accessible-label: root.filename;
        }
        TouchArea {
            enabled: !root.modal && !root.show-more && root.has-image;
            double-clicked => { root.command("fullscreen"); }
        }
        if !root.has-image: Rectangle {
            width: min(440px, parent.width - 24px); height: min(248px, parent.height);
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            border-radius: 18px; background: Theme.surface;
            VerticalLayout {
                padding: 20px; spacing: 10px; alignment: center;
                Rectangle {
                    height: 52px;
                    Rectangle {
                        width: 48px; height: 48px; x: (parent.width - self.width)/2;
                        border-radius: 12px; background: Theme.raised;
                        Image { source: root.error-title != "" ? Icons.error : Icons.image; colorize: root.error-title != "" ? Theme.danger : Theme.accent; width: 24px; height: 24px; x: 12px; y: 12px; }
                    }
                }
                Text { text: root.loading ? "Opening media" : root.error-title != "" ? root.error-title : "Open a local file"; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.loading ? "Your file will appear here." : root.error-title != "" ? root.error-detail : "Images, animations and videos. Simply drop a file here."; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; overflow: elide; max-height: 64px; }
                if !root.loading: HorizontalLayout {
                    alignment: center; padding-top: 8px;
                    Tool { label: root.error-title != "" ? "Open another file" : "Open file"; icon: Icons.open; has-icon: true; primary: true; enabled: root.tools-enabled; hint: "Open file  ·  Ctrl+O"; clicked => { root.command("open"); } }
                }
                if !root.loading: Text { text: root.error-title != "" ? "You can still navigate to the next file." : "JPG, PNG, GIF, MP4 and more  ·  Ctrl+O"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
            }
        }
    }

    // Chrome alone fades; the image is never put into an opacity layer.
    header := Rectangle {
        // Reuse static chrome during animation playback instead of submitting
        // every icon and label again with each image frame. Still images need no layer.
        cache-rendering-hint: root.animated;
        x: 0px; y: 0px; width: root.width; height: Theme.header-height;
        background: Theme.surface; opacity: !root.fullscreen || root.chrome ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 120ms; }
        header-touch := TouchArea {
            enabled: root.header-enabled;
            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-window(); } }
            double-clicked => { root.command("maximize"); }
        }
        Rule { y: parent.height - 1px; }
        HorizontalLayout {
            padding-left: 12px; spacing: 0px;
            Rectangle { width: 20px; Image { source: @image-url("../assets/kova.svg"); width: 20px; height: 20px; y: (parent.height - self.height)/2; } }
            Rectangle { width: 10px; }
            Text { text: root.filename; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            if root.width > 900px && root.has-image: Text {
                text: root.loading ? "Opening media…" : root.image-detail;
                color: Theme.muted; font-size: 11px; vertical-alignment: center;
                max-width: 240px; overflow: elide;
            }
            Rectangle { width: 12px; }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Tool { icon: Icons.open; has-icon: true; hint: "Open file  ·  Ctrl+O"; enabled: root.header-enabled; clicked => { root.command("open"); } } }
            Rectangle { width: 8px; }
            Tool { icon: Icons.minimize; has-icon: true; hint: "Minimize"; width: 44px; height: Theme.header-height - 1px; border-radius: 0px; enabled: root.header-enabled; clicked => { root.command("minimize"); } }
            Tool { icon: Icons.maximize; has-icon: true; hint: "Maximize / restore"; width: 44px; height: Theme.header-height - 1px; border-radius: 0px; enabled: root.header-enabled; clicked => { root.command("maximize"); } }
            Tool { icon: Icons.close; has-icon: true; hint: "Close window"; width: 44px; height: Theme.header-height - 1px; border-radius: 0px; danger: true; enabled: root.header-enabled; clicked => { root.command("close"); } }
        }
    }

    bar := Rectangle {
        cache-rendering-hint: root.animated;
        width: min(root.is-video ? 920px : 760px, root.width - 24px);
        x: (root.width - self.width)/2;
        y: root.height - root.bar-height - 12px;
        height: root.bar-height; border-radius: 16px;
        border-width: 1px; border-color: Theme.stroke;
        background: Theme.surface; opacity: root.chrome ? 1 : 0; visible: self.opacity > 0;
        animate opacity { duration: 120ms; }
        bar-touch := TouchArea { enabled: root.tools-enabled; }
        HorizontalLayout {
            padding: 12px; spacing: root.compact ? 6px : 10px;
            Group {
                horizontal-stretch: 0;
                Tool { icon: Icons.previous; has-icon: true; hint: "Previous file  ·  Left"; enabled: root.tools-enabled && root.can-previous; clicked => { root.command("previous"); } }
                Text { text: root.position-label == "" ? "—" : root.position-label; color: Theme.secondary; font-size: 12px; width: root.compact ? 44px : 56px; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                Tool { icon: Icons.next; has-icon: true; hint: "Next file  ·  Right"; enabled: root.tools-enabled && root.can-next; clicked => { root.command("next"); } }
            }
            if !root.is-video: Rectangle { horizontal-stretch: 1; }
            if !root.is-video: Group {
                horizontal-stretch: 0;
                Tool { icon: Icons.minus; has-icon: true; hint: "Zoom out  ·  -"; enabled: root.image-tools; clicked => { root.command("out"); } }
                Tool { label: root.has-image ? root.zoom-label : "—"; width: 60px; hint: "Zoom · Reset to actual size"; enabled: root.image-tools; clicked => { root.command("actual"); } }
                Tool { icon: Icons.plus; has-icon: true; hint: "Zoom in  ·  +"; enabled: root.image-tools; clicked => { root.command("in"); } }
            }
            if !root.is-video: Group {
                horizontal-stretch: 0;
                Tool { label: "Fit"; checkable: true; active: root.fit-active && root.has-image; hint: "Fit to window  ·  0"; enabled: root.image-tools; clicked => { root.command("fit"); } }
                Tool { label: "100%"; checkable: true; active: root.actual-active && root.has-image; hint: "Actual size  ·  1"; enabled: root.image-tools; clicked => { root.command("actual"); } }
            }
            if !root.is-video: Divider { }
            if !root.is-video: VerticalLayout { alignment: center; horizontal-stretch: 0; Tool { icon: Icons.rotate; has-icon: true; hint: "Rotate right  ·  R"; enabled: root.image-tools; clicked => { root.command("right"); } } }
            if root.animated && !root.is-video: VerticalLayout { alignment: center; horizontal-stretch: 0; Tool { icon: root.paused ? Icons.play : Icons.pause; has-icon: true; checkable: true; active: !root.paused; hint: root.paused ? "Play animation  ·  Space" : "Pause animation  ·  Space"; enabled: root.image-tools; clicked => { root.command("pause"); } } }
            if root.is-video: Group {
                horizontal-stretch: 1;
                Tool { icon: root.paused ? Icons.play : Icons.pause; has-icon: true; hint: root.paused ? "Play video  /  Space" : "Pause video  /  Space"; enabled: root.tools-enabled && root.has-image; clicked => { root.command("pause"); } }
                Track { value: root.video-progress; label: "Seek video / Ctrl+Left or Ctrl+Right: 5 seconds"; enabled: root.tools-enabled && root.has-image; changed(value) => { root.seek(value); } }
                Text { text: root.time-label; color: Theme.secondary; font-size: 12px; width: root.compact ? 84px : 106px; horizontal-alignment: center; vertical-alignment: center; }
                Tool { icon: root.muted || root.volume == 0 ? Icons.mute : Icons.volume; has-icon: true; hint: "Mute / unmute  /  M"; active: root.muted; checkable: true; enabled: root.tools-enabled; clicked => { root.command("mute"); } }
                Track { value: root.volume; label: "Volume"; width: root.compact ? 58px : 80px; horizontal-stretch: 0; enabled: root.tools-enabled; changed(value) => { root.volume-change(value); } }
            }
            if !root.is-video: Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Tool { icon: root.fullscreen ? Icons.exit-fullscreen : Icons.fullscreen; has-icon: true; hint: root.fullscreen ? "Leave fullscreen  ·  Esc" : "Fullscreen  ·  F11"; checkable: true; active: root.fullscreen; enabled: root.tools-enabled; clicked => { root.command("fullscreen"); } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Tool { icon: Icons.more; has-icon: true; hint: "More actions"; active: root.show-more; enabled: root.chrome && !root.modal; clicked => { root.show-more = !root.show-more; } } }
        }
    }

    if root.feedback != "" && root.has-image && !root.modal && !root.show-more: Rectangle {
        x: (root.width - self.width)/2; y: max(canvas.y, Theme.header-height) + 20px;
        width: min(root.width - 32px, feedback-text.preferred-width + 36px); height: 44px;
        border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.stroke;
        feedback-text := Text { text: root.feedback; color: Theme.text; font-size: 15px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }

    if root.chrome && !root.show-more && !root.modal && Interaction.hint != "": Rectangle {
        x: (root.width - self.width)/2; y: bar.y - 36px; height: 28px;
        width: hint-text.preferred-width + 22px; border-radius: 9px; background: Theme.raised; border-width: 1px; border-color: Theme.stroke;
        hint-text := Text { text: Interaction.hint; color: Theme.secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.status != "" && (root.has-image || root.error-title == "") && !root.modal: Rectangle {
        x: 18px; y: bar.y - 42px; height: 30px;
        width: min(parent.width - 36px, notice.preferred-width + 28px);
        border-radius: 9px; background: Theme.raised; border-width: 1px; border-color: Theme.stroke;
        notice := Text { x: 14px; width: parent.width - 28px; text: root.status; color: Theme.secondary; vertical-alignment: center; overflow: elide; font-size: 12px; }
    }

    if root.show-more: Rectangle {
        TouchArea { clicked => { root.show-more = false; Interaction.hint = ""; } }
        Rectangle {
            width: 306px; height: min(452px, root.height - Theme.header-height - root.bar-height - 16px);
            x: bar.x + bar.width - self.width - 12px; y: bar.y - self.height - 8px;
            border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.stroke;
            TouchArea { }
            VerticalLayout {
                padding: 8px; spacing: 4px;
                ScrollView {
                    viewport-width: self.width; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { spacing: 2px;
                        Text { text: "VIEW"; color: Theme.muted; font-size: 10px; font-weight: 600; height: 24px; vertical-alignment: center; x: 12px; }
                        Tool { menu: true; label: "Fit width"; icon: Icons.width; has-icon: true; shortcut: "W"; enabled: root.has-image && !root.loading && !root.is-video; clicked => { root.command("width"); root.show-more=false; } }
                        Tool { menu: true; label: "Rotate left"; icon: Icons.rotate; has-icon: true; shortcut: "Shift+R"; enabled: root.has-image && !root.loading && !root.is-video; clicked => { root.command("left"); root.show-more=false; } }
                        Tool { menu: true; label: "Flip horizontal"; icon: Icons.flip-h; has-icon: true; shortcut: "H"; enabled: root.has-image && !root.loading && !root.is-video; clicked => { root.command("horizontal"); root.show-more=false; } }
                        Tool { menu: true; label: "Flip vertical"; icon: Icons.flip-v; has-icon: true; shortcut: "V"; enabled: root.has-image && !root.loading && !root.is-video; clicked => { root.command("vertical"); root.show-more=false; } }
                        Rule { }
                        Tool { menu: true; label: root.is-video ? "Copy path" : "Copy image"; icon: Icons.copy; has-icon: true; shortcut: "Ctrl+C"; enabled: root.has-image && !root.loading; clicked => { root.command("copy"); root.show-more=false; } }
                        Tool { menu: true; label: "Copy path"; icon: Icons.path; has-icon: true; shortcut: "Ctrl+Shift+C"; enabled: root.has-image && !root.loading; clicked => { root.command("path"); root.show-more=false; } }
                        Tool { menu: true; label: "Show in Explorer"; icon: Icons.folder; has-icon: true; enabled: root.has-image && !root.loading; clicked => { root.command("reveal"); root.show-more=false; } }
                        Tool { menu: true; label: "Open with…"; icon: Icons.open; has-icon: true; enabled: root.has-image && !root.loading; clicked => { root.command("open-with"); root.show-more=false; } }
                        Tool { menu: true; label: "Move to Recycle Bin"; icon: Icons.delete; has-icon: true; shortcut: "Del"; danger: true; enabled: root.has-image && !root.loading; clicked => { root.command("delete"); root.show-more=false; } }
                        Rule { }
                        Tool { menu: true; label: "File information"; icon: Icons.info; has-icon: true; shortcut: "I"; enabled: root.has-image; clicked => { root.command("info"); root.show-more=false; } }
                        Tool { menu: true; label: "Settings"; icon: Icons.settings; has-icon: true; clicked => { root.command("settings"); root.show-more=false; } }
                    }
                }
                Rule { }
                Text { text: "Kova Image  0.1.0  ·  Early Development"; color: Theme.muted; font-size: 11px; height: 26px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    if root.modal: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.show-info=false; root.show-settings=false; } }
        Rectangle {
            width: min(492px, parent.width - 40px); height: min(root.show-settings ? 544px : 410px, parent.height - 32px);
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            border-radius: 16px; background: Theme.surface; border-width: 1px; border-color: Theme.stroke;
            TouchArea { }
            VerticalLayout {
                padding: 20px; spacing: 14px;
                HorizontalLayout {
                    height: 36px; spacing: 12px;
                    Rectangle { width: 20px; Image { source: root.show-settings ? Icons.settings : Icons.info; colorize: Theme.accent; width: 20px; height: 20px; y: (parent.height - self.height)/2; } }
                    Text { text: root.show-settings ? "Settings" : "File information"; color: Theme.text; font-size: 18px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    Tool { icon: Icons.close; has-icon: true; hint: "Close panel  ·  Esc"; clicked => { root.show-info=false; root.show-settings=false; } }
                }
                Rule { }
                ScrollView {
                    viewport-width: self.width; horizontal-scrollbar-policy: always-off;
                    // One unconditional layout lets ScrollView measure both panel contents.
                    VerticalLayout {
                        if root.show-info: VerticalLayout {
                            spacing: 14px;
                            for field in root.info-fields: HorizontalLayout {
                                spacing: 16px;
                                Text { text: field.label; color: Theme.muted; font-size: 12px; width: 80px; }
                                Text { text: field.value; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                        if root.show-settings: VerticalLayout {
                            spacing: 4px;
                            Text { text: "PLAYBACK & NAVIGATION"; color: Theme.muted; font-size: 10px; font-weight: 600; height: 24px; }
                            ToggleRow { label: "Autoplay animations"; checked <=> root.autoplay; toggled(value) => { root.setting("autoplay",value); } }
                            ToggleRow { label: "Honor animation loop count"; checked <=> root.looping; toggled(value) => { root.setting("looping",value); } }
                            ToggleRow { label: "Autoplay videos"; checked <=> root.video-autoplay; toggled(value) => { root.setting("video-autoplay",value); } }
                            ToggleRow { label: "Loop videos"; checked <=> root.video-loop; toggled(value) => { root.setting("video-loop",value); } }
                            ToggleRow { label: "Natural filename sorting"; checked <=> root.natural-sort; toggled(value) => { root.setting("natural",value); } }
                            ToggleRow { label: "Auto-hide viewing controls"; checked <=> root.auto-hide; toggled(value) => { root.setting("hide",value); } }
                            ToggleRow { label: "Mouse wheel zooms (off: navigate)"; checked <=> root.wheel-zoom; toggled(value) => { root.setting("wheel",value); } }
                            Rule { }
                            Text { text: "APPEARANCE"; color: Theme.muted; font-size: 10px; font-weight: 600; height: 24px; }
                            ToggleRow { label: "Sharp pixels at high zoom"; checked <=> root.pixelated; toggled(value) => { root.setting("pixels",value); } }
                            ToggleRow { label: "Light image background"; checked: root.light-background; toggled(value) => { root.setting("background",value); } }
                            HorizontalLayout { spacing: 6px;
                                Text { text: "Default fit"; color: Theme.secondary; vertical-alignment: center; horizontal-stretch: 1; }
                                Tool { label: "Window"; checkable: true; active: root.default-fit == "window"; clicked => { root.setting("fit-window",true); } }
                                Tool { label: "Width"; checkable: true; active: root.default-fit == "width"; clicked => { root.setting("fit-width",true); } }
                                Tool { label: "100%"; checkable: true; active: root.default-fit == "actual"; clicked => { root.setting("fit-actual",true); } }
                            }
                            Rule { }
                            Text { text: "WINDOWS INTEGRATION"; color: Theme.muted; font-size: 10px; font-weight: 600; height: 24px; }
                            Text { text: "Images: JPG, PNG, GIF, WebP, BMP, TIFF, APNG, ICO\nVideos: MP4, MOV, WebM, MKV (Windows codecs)"; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                            Tool { menu: true; filled: true; label: "Register Kova Image for Open with"; clicked => { root.command("register"); } }
                            Tool { menu: true; label: "Choose default viewer in Windows Settings"; clicked => { root.command("defaults"); } }
                        }
                    }
                }
                HorizontalLayout {
                    height: 36px;
                    Text { text: root.show-settings ? "Saved locally on this device." : "View transformations leave the file unchanged."; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                    Tool { label: "Done"; primary: true; clicked => { root.show-info=false; root.show-settings=false; } }
                }
            }
        }
    }
}
