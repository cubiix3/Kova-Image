// Original Kova utility icons; shared 24-unit grid and 1.65-unit stroke.
export global Icons {
    out property <image> volume: @image-url("../assets/icons/volume.svg");
    out property <image> mute: @image-url("../assets/icons/mute.svg");
    out property <image> previous: @image-url("../assets/icons/previous.svg");
    out property <image> next: @image-url("../assets/icons/next.svg");
    out property <image> minus: @image-url("../assets/icons/minus.svg");
    out property <image> plus: @image-url("../assets/icons/plus.svg");
    out property <image> open: @image-url("../assets/icons/open.svg");
    out property <image> rotate: @image-url("../assets/icons/rotate.svg");
    out property <image> fit: @image-url("../assets/icons/fit.svg");
    out property <image> fullscreen: @image-url("../assets/icons/fullscreen.svg");
    out property <image> exit-fullscreen: @image-url("../assets/icons/exit-fullscreen.svg");
    out property <image> more: @image-url("../assets/icons/more.svg");
    out property <image> close: @image-url("../assets/icons/close.svg");
    out property <image> maximize: @image-url("../assets/icons/maximize.svg");
    out property <image> minimize: @image-url("../assets/icons/minimize.svg");
    out property <image> play: @image-url("../assets/icons/play.svg");
    out property <image> pause: @image-url("../assets/icons/pause.svg");
    out property <image> info: @image-url("../assets/icons/info.svg");
    out property <image> image: @image-url("../assets/icons/image.svg");
    out property <image> error: @image-url("../assets/icons/error.svg");
    out property <image> flip-h: @image-url("../assets/icons/flip-h.svg");
    out property <image> flip-v: @image-url("../assets/icons/flip-v.svg");
    out property <image> copy: @image-url("../assets/icons/copy.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> delete: @image-url("../assets/icons/delete.svg");
    out property <image> settings: @image-url("../assets/icons/settings.svg");
    out property <image> width: @image-url("../assets/icons/width.svg");
    out property <image> path: @image-url("../assets/icons/path.svg");
