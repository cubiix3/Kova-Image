// Shared Kova surfaces and metrics. No blur, shadows, or animated backgrounds.
export global Theme {
    in-out property <color> canvas: #101214;
    in-out property <color> surface: #1b1e22;
    in-out property <color> raised: #24282d;
    in-out property <color> hover: #30363d;
    in-out property <color> pressed: #3a434c;
    in-out property <color> stroke: #363d45;
    in-out property <color> divider: #2b3036;
    in-out property <color> text: #f0f2f5;
    in-out property <color> secondary: #b2bac4;
    in-out property <color> muted: #8d98a5;
    in-out property <color> disabled: #626d79;
    in-out property <color> accent: #86d5f4;
    in-out property <color> selected: #253e4b;
    in-out property <color> danger: #f49b9b;
    in-out property <color> primary-border: #426272;
    in-out property <color> toggle-thumb: #14252e;
    out property <length> header-height: 40px;
    out property <length> bar-height: 60px;
    out property <length> control-height: 32px;
    out property <length> radius: 9px;
}

// Interaction metadata only. Image state and decoding never enter this global.
export global Interaction {
    in-out property <string> hint;
    in-out property <bool> slider-focused;
    in-out property <bool> keyboard: false;
    in-out property <int> next-focus-id: 1;
    in-out property <int> focused-control: 0;
}
